# Configuração do MySQL no Railway (exemplo, sem senhas reais)
# Para rodar no Eclipse, use o host e a porta PUBLICOS do TCP Proxy do Railway.
DB_URL=jdbc:mysql://HOST_PUBLICO:PORTA_PUBLICA/railway
DB_USER=root
DB_PASSWORD=SUA_SENHA

# Se o Java estiver rodando dentro do Railway, pode usar estas variáveis
# no lugar de DB_URL, DB_USER e DB_PASSWORD:
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
